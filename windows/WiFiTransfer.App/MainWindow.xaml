<Window x:Class="WiFiTransfer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DroidShare-WiFi" Height="420" Width="620"
        MinHeight="360" MinWidth="520" Background="#111827"
        Foreground="#F9FAFB">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="DroidShare-WiFi" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Local connection foundation" Foreground="#9CA3AF" Margin="0,6,0,0"/>
        </StackPanel>
        <Border Grid.Row="2" Background="#1F2937" CornerRadius="10" Padding="16">
            <StackPanel>
                <TextBlock Text="Windows connection service" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" Text="Starting…" Margin="0,8,0,0" Foreground="#A7F3D0"/>
                <TextBlock x:Name="NetworkText" Text="Waiting for network details…" Margin="0,4,0,0" Foreground="#9CA3AF"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Background="#1F2937" CornerRadius="10" Padding="16" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Phase 1 diagnostic mode" FontWeight="SemiBold"/>
                <TextBlock Text="The app is listening for Android discovery packets and a TCP HELLO handshake. File access and file transfer are not enabled in this build."
                           TextWrapping="Wrap" Foreground="#D1D5DB" Margin="0,8,0,0"/>
                <TextBlock x:Name="LastEventText" Text="No Android device connected yet." Foreground="#9CA3AF" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="4" Text="UDP discovery :45820   •   TCP diagnostic :45821"
                   Foreground="#6B7280" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
