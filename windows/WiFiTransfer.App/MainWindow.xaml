<Window x:Class="WiFiTransfer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DroidShare-WiFi" Height="690" Width="760"
        MinHeight="620" MinWidth="680" Background="#111827"
        Foreground="#F9FAFB">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="DroidShare-WiFi" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Local connection and pairing foundation" Foreground="#9CA3AF" Margin="0,6,0,0"/>
            </StackPanel>
            <Border Grid.Row="2" Background="#1F2937" CornerRadius="10" Padding="16">
                <StackPanel>
                    <TextBlock Text="Windows connection service" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" Text="Starting…" Margin="0,8,0,0" Foreground="#A7F3D0"/>
                    <TextBlock x:Name="NetworkText" Text="Waiting for network details…" Margin="0,4,0,0" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="4" Background="#1F2937" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Pairing identity · Secure QR" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock x:Name="PairingStatusText"
                                   Text="Preparing Windows device identity…"
                                   Foreground="#D1D5DB" Margin="0,10,12,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="FingerprintText" Text="Certificate fingerprint: preparing…"
                                   Foreground="#9CA3AF" Margin="0,8,12,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ExpiryText" Text="QR expires in: —"
                                   Foreground="#FCD34D" Margin="0,8,12,0"/>
                        <Button x:Name="RefreshQrButton" Content="Refresh QR"
                                Padding="14,8" Margin="0,14,8,0" HorizontalAlignment="Left"
                                Click="RefreshQrButton_Click" IsEnabled="False"/>
                        <Button Content="Manage paired devices"
                                Padding="14,8" Margin="0,14,0,0" HorizontalAlignment="Left"
                                Click="ManageDevicesButton_Click"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="10"
                            VerticalAlignment="Center">
                        <Image x:Name="PairingQrImage" Width="190" Height="190"
                               Stretch="Uniform"/>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Row="5" Background="#1F2937" CornerRadius="10" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Phase 1 diagnostic mode" FontWeight="SemiBold"/>
                    <TextBlock Text="Scan the QR on Android and tap Connect securely. Windows will ask you to approve the Android identity. The QR nonce is single-use; file access and transfer remain disabled."
                               TextWrapping="Wrap" Foreground="#D1D5DB" Margin="0,8,0,0"/>
                    <TextBlock x:Name="LastEventText" Text="No Android device connected yet."
                               Foreground="#9CA3AF" Margin="0,14,0,0"/>
                    <TextBlock Text="UDP discovery :45820   •   TCP diagnostic :45821   •   TLS diagnostic :45822"
                               Foreground="#6B7280" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
